{
  "mcpServers": {
    "ask-buddy-memory": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/servers/memory_server.py"],
      "env": {
        "ASK_BUDDY_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    },
    "feishu-assistant-readonly": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/servers/lark_readonly_server.py"],
      "env": {
        "ASK_BUDDY_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    },
    "one-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "one-search-mcp@1.2.2"],
      "env": {
        "SEARCH_PROVIDER": "duckduckgo",
        "ALLOW_PRIVATE_NETWORK": "false"
      }
    }
  }
}
